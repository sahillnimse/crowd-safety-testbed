# Environment variables for Crowd Safety Testbed
#
# IMPORTANT: nothing in this project reads a .env FILE. There is no
# python-dotenv dependency and no load_dotenv() call anywhere, so copying this
# to `.env` on its own has no effect — the hosted models will still report
# "blocked" in the UI. This file documents which variables exist; you have to
# set them in your actual environment.
#
#   PowerShell (current session):
#     $env:ROBOFLOW_API_KEY = "your_key_here"
#
#   PowerShell (persistent, new terminals only):
#     setx ROBOFLOW_API_KEY "your_key_here"
#
#   bash / zsh:
#     export ROBOFLOW_API_KEY="your_key_here"
#
# Set it BEFORE starting `python -m webapp`: the server reads the variable
# from its own process environment, so a key exported in a different terminal
# after the server started will not be seen by it.

# Roboflow API key for cloud-hosted inference models
# (roboflow_combined, indian_anpr, roboflow_traffic).
# Without it those three models report status "blocked" and cannot be
# selected — which is deliberate: they fail at load time otherwise.
# Get a key at https://roboflow.com (Workspace Settings -> Private API Key)
ROBOFLOW_API_KEY=your_roboflow_api_key_here
